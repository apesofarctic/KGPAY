<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose owns almost all theming (see ui/theme/Theme.kt). This XML theme only
         needs to exist so the Activity has a window background before Compose draws. -->
    <style name="Theme.KGPay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kgpay_background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/kgpay_primary</item>
    </style>
</resources>
